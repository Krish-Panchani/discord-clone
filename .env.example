# -----------------------------------------------------------------------------
# Database (Prisma ORM 7 — connection URL lives in prisma.config.ts for CLI;
# the app uses the same DATABASE_URL with @prisma/adapter-pg in lib/db.ts)
# After changing the schema: npx prisma migrate dev && npx prisma generate
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:26257/DATABASE?sslmode=verify-full"

# -----------------------------------------------------------------------------
# Clerk (auth + middleware). Required at runtime by @clerk/nextjs.
# https://dashboard.clerk.com → API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Optional: if Clerk shows wrong sign-in URLs in production, set these to match
# your App Router paths (this project uses /sign-in and /sign-up).
# NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
# NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# -----------------------------------------------------------------------------
# UploadThing (file uploads — app/api/uploadthing)
# https://uploadthing.com/dashboard
# -----------------------------------------------------------------------------
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="..."

# -----------------------------------------------------------------------------
# Site URL (Socket.IO client in components/providers/socket-provider.tsx)
# Must be the origin the browser uses (no trailing path). Local dev example:
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# LiveKit (voice/video — app/api/livekit/route.ts + components/media-room.tsx)
# https://cloud.livekit.io
# -----------------------------------------------------------------------------
NEXT_PUBLIC_LIVEKIT_URL="wss://YOUR_PROJECT.livekit.cloud"
LIVEKIT_API_KEY="APIxxxxxxxx"
LIVEKIT_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
